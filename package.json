{
  "name": "human-activity-recognition",
  "private": true,
  "type": "module",
  "description": "HAR course project: slide decks (JSX -> PPTX), reports and presenter directions (JSX -> PDF).",
  "workspaces": [
    "slides",
    "slides/apps/*",
    "slides/packages/*",
    "report",
    "slide-directions"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "bash slides/scripts/setup.sh",
    "slides": "bun run --cwd slides generate --pdf",
    "report": "bun run --cwd report build",
    "directions": "bun run --cwd slide-directions build",
    "build": "bun run slides && bun run report && bun run directions",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:docs": "python3 scripts/check-docs.py",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run lint && bun run lint:docs && bun run typecheck && bun run test",
    "clean": "rm -rf slides/output report/output slide-directions/output"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.9.2"
  }
}
