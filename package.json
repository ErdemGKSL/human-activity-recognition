{
  "name": "pptx-generator",
  "private": true,
  "type": "module",
  "description": "Template monorepo: typed deck data -> Takumi JSX -> SVG -> native PPTX via ppt-master.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "generate": "bun run --cwd apps/cli generate",
    "generate:svg": "bun run --cwd apps/cli generate --svg-only",
    "decks": "bun run --cwd apps/cli generate --list",
    "inspect": ".venv/bin/python scripts/inspect-pptx.py",
    "sync:motion": ".venv/bin/python scripts/sync-motion-presets.py && biome format --write packages/core/src/motion-presets.generated.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:docs": "python3 scripts/check-docs.py",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run lint && bun run lint:docs && bun run typecheck && bun run test",
    "clean": "rm -rf output **/*.tsbuildinfo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.9.2"
  }
}
