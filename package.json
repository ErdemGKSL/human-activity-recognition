{
  "name": "human-activity-recognition",
  "private": true,
  "type": "module",
  "description": "HAR course project: the proposal deck as PPTX and slide PDF (DeckCraft) plus its presenter guide (takumi-pdf).",
  "workspaces": [
    "report",
    "slide-directions"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "report": "bun run --cwd report build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:docs": "python3 scripts/check-docs.py",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run lint && bun run lint:docs && bun run typecheck && bun run test",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.9.2"
  }
}
